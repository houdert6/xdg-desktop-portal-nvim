[Unit]
Description=NeoVim-powered file chooser desktop portal backend
PartOf=graphical-session.target
After=xdg-desktop-portal.service

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.nvim
ExecStart=/usr/lib/xdg-desktop-portal-nvim
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
